# Local / deploy — preencha com valores do EasyPanel (projeto ragnarok-donna)
# Ver docs/EASYPANEL.md e docs/SPRINTS.md

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragnarok

# Sessão JWT (obrigatório, mín. 32 caracteres)
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Fallback quando usuário tem vários tenants (dev)
DEFAULT_TENANT_SLUG=ragnaroks

# Seed owner (npm run seed:owner) — não commitar senha real
# SEED_OWNER_EMAIL=admin@ragnaroks.local
# SEED_OWNER_PASSWORD=

# Redis (rede EasyPanel: ragnarok-donna_redis:6379)
# REDIS_URL=redis://default:<SENHA>@ragnarok-donna_redis:6379/0

EVOLUTION_URL=https://ragnarok-donna-evolution.kxryyk.easypanel.host
N8N_URL=https://ragnarok-donna-n8n.kxryyk.easypanel.host
