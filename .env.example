# Local / deploy — preencha com valores do EasyPanel (projeto ragnarok-donna)
# Ver docs/EASYPANEL.md e docs/SPRINTS.md

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragnarok

# Máx. conexões do pool por processo Next.js (default 3). EasyPanel/Postgres pequeno: não subir.
# DATABASE_POOL_MAX=3

# Sessão JWT (obrigatório, mín. 32 caracteres)
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Fallback quando usuário tem vários tenants (dev)
DEFAULT_TENANT_SLUG=ragnaroks

# Seed owner (npm run seed:owner) — não commitar senha real
# SEED_OWNER_EMAIL=admin@ragnaroks.local
# SEED_OWNER_PASSWORD=

# Redis (rede EasyPanel: ragnarok-donna_redis:6379)
# REDIS_URL=redis://default:<SENHA>@ragnarok-donna_redis:6379/0

EVOLUTION_URL=https://ragnarok-donna-evolution.kxryyk.easypanel.host
EVOLUTION_API_KEY=
N8N_URL=https://ragnarok-donna-n8n.kxryyk.easypanel.host

# URL pública do app (webhook Evolution). No EasyPanel: NEXT_PUBLIC_APP_URL=https://$(PRIMARY_DOMAIN)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo opcional no webhook: /api/agent/webhook?secret=...
# AGENT_WEBHOOK_SECRET=

# Token de serviço (n8n/MCP → /api/agent/orchestrate). Mín. 16 chars.
# AGENT_SERVICE_TOKEN=

# Web Push PWA (gerar: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)")
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@barbeariaragnarok.com.br

# Convites de equipe (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# Use UM destes (e-mail deve estar verificado no Resend):
# RESEND_FROM_EMAIL=contato@fabricadosdados.com.br
# RESEND_FROM=Painel Ragnarok <contato@fabricadosdados.com.br>
# NÃO use só o nome em RESEND_FROM (ex.: "Painel Donna") — precisa do @

# LLM (humanização da Donna). OpenAI oficial ou OpenRouter.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
